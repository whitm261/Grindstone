{
  "name": "movingweight",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "apk": "START_TIME=$(date +%s) && cd android && ./gradlew assembleRelease && cd .. && END_TIME=$(date +%s) && BUILD_DURATION=$((END_TIME - START_TIME)) && bun scripts/notify-build.ts android/app/build/outputs/apk/release/app-release.apk $BUILD_DURATION && echo \"\\nAPK: $PWD/android/app/build/outputs/apk/release/app-release.apk\""
  },
